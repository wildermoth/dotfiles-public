# Colors and styling only. No keybinds.

# Pane border styling - more visible colors
set -g pane-border-style "fg=<<ui.border>>"
set -g pane-active-border-style "fg=<<ui.border_active>>"

# Pane status indicator at top
set -g pane-border-status top
set -g pane-border-format "#{?pane_active,#[align=right]#[fg=<<ui.fg>>] #{pane_current_command} #[default],}"

# Message styling
set -g message-style "bg=<<ui.surface>>,fg=<<ui.fg>>"
set -g message-command-style "bg=<<ui.surface>>,fg=<<ui.fg>>"

# Copy mode styling
set -g mode-style "bg=<<ui.surface>>,fg=<<ui.fg>>"
