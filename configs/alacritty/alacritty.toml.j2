# Shared Alacritty. One set + one end branch.
<%- if OS == "windows" -%>
<%- set font_size = "12.0" -%>
<%- set font_extra = "builtin_box_drawing = true" -%>
<%- set window_extra = "" -%>
<%- set shell_prog = "wsl.exe" -%>
<%- set shell_args = '["--distribution", "Ubuntu", "--cd", "~", "--exec", "zsh", "-l"]' -%>
<%- elif OS == "mac" -%>
<%- set font_size = "16.0" -%>
<%- set font_extra = "" -%>
<%- set window_extra = 'option_as_alt = "Both"' -%>
<%- set shell_prog = "/bin/zsh" -%>
<%- set shell_args = "[]" -%>
<%- else -%>
<%- set font_size = "16.0" -%>
<%- set font_extra = "" -%>
<%- set window_extra = "" -%>
<%- set shell_prog = "/bin/zsh" -%>
<%- set shell_args = "[]" -%>
<%- endif %>
[window]
title = "Alacritty"
dynamic_title = true
opacity = 0.93
blur = true
startup_mode = "Maximized"
<< window_extra >>

[cursor]
style = { shape = "Block", blinking = "On" }
unfocused_hollow = true

[scrolling]
history = 10000
multiplier = 3

[font]
size = << font_size >>
<< font_extra >>

[font.normal]
family = "JetBrainsMono Nerd Font"
style = "Regular"

[font.bold]
family = "JetBrainsMono Nerd Font"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font"
style = "Italic"

[font.bold_italic]
family = "JetBrainsMono Nerd Font"
style = "Bold Italic"

[terminal.shell]
program = "<< shell_prog >>"
args = << shell_args >>

[[keyboard.bindings]]
key = "N"
mods = "Control"
action = "SpawnNewInstance"

<% if OS == "windows" %>
[font.offset]
x = 0
y = 0

[font.glyph_offset]
x = 0
y = 1

[[keyboard.bindings]]
action = "Paste"
key = "V"
mods = "Control"

[[keyboard.bindings]]
key = "X"
mods = "Control"
chars = "\u0003"

[[keyboard.bindings]]
key = "Right"
mods = "Control"
chars = "\u001b[1;5C"

[[keyboard.bindings]]
key = "Back"
mods = "Control"
chars = "\u0017"

[[keyboard.bindings]]
key = "Delete"
mods = "Control"
chars = "\u0005"
<% elif OS == "mac" %>
[[keyboard.bindings]]
action = "Paste"
key = "V"
mods = "Control"

[[keyboard.bindings]]
key = "X"
mods = "Control"
chars = "\u0003"

[[keyboard.bindings]]
key = "Left"
mods = "Control"
chars = "\u001b[1;5D"

[[keyboard.bindings]]
key = "Right"
mods = "Control"
chars = "\u001b[1;5C"

[[keyboard.bindings]]
key = "Left"
mods = "Option"
chars = "\u001b[1;5D"

[[keyboard.bindings]]
key = "Right"
mods = "Option"
chars = "\u001b[1;5C"

[[keyboard.bindings]]
key = "Left"
mods = "Command"
chars = "\u0001"

[[keyboard.bindings]]
key = "Right"
mods = "Command"
chars = "\u0005"

[[keyboard.bindings]]
key = "A"
mods = "Command"
chars = "\u0001"
<% endif %>
