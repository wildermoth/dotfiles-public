; F23 bottom row: numpad.
F23 & SC031::
    MarkTabUsed()
    Send {Blind}{/} ; / key = slash
return
F23 & SC032::
    MarkTabUsed()
    Send {Blind}{0} ; K = 0
return
F23 & SC033::
    MarkTabUsed()
    Send {Blind}{1} ; H = 1
return
F23 & SC034::
    MarkTabUsed()
    Send {Blind}{2} ; , = 2
return
F23 & SC035::
    MarkTabUsed()
    Send {Blind}{3} ; . = 3
return
F23 & RShift::
    MarkTabUsed()
    Send {Blind}{.} ; RShift = decimal point
return
F23 & SC039::
    MarkTabUsed()
    Send {Blind}{space} ; Space
return
