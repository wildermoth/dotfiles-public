; F24 bottom row: cut/copy/save/paste.
F24 & SC02C::
    MarkCapsUsed()
    Send {Blind}{CtrlDown}{x}{CtrlUp} ; X
return
F24 & SC02D::
    MarkCapsUsed()
    Send {Blind}{CtrlDown}{c}{CtrlUp} ; C
return
F24 & SC02E::
    MarkCapsUsed()
    Send {Blind}{CtrlDown}{s}{CtrlUp} ; D
return
F24 & SC02F::
    MarkCapsUsed()
    Send {Blind}{CtrlDown}{v}{CtrlUp} ; V
return
F24 & SC030::
    MarkCapsUsed()
    Send {Blind}{CtrlDown}{z}{CtrlUp} ; Z
return
F24 & SC031::
    MarkCapsUsed()
    Send {Blind}{CtrlDown}{l}{CtrlUp} ; /
return
F24 & SC032::
    MarkCapsUsed()
    Send {Blind}{PrintScreen} ; K
return
F24 & SC033::
    MarkCapsUsed()
    Send {Blind}{Backspace} ; H
return
F24 & SC034::
    MarkCapsUsed()
    Send {Blind}{Tab} ; ,
return
F24 & SC035::
    MarkCapsUsed()
    Send {Blind}{.} ; . - Opens Lazygit
return
F24 & RShift::
    MarkCapsUsed()
    Send {Click Right} ; Rshift
return
F24 & SC039::
    MarkCapsUsed()
    ; Send {Blind}{Esc} ; Space
return
