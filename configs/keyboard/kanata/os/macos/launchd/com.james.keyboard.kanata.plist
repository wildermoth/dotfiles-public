<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: start Kanata at boot. __KANATA_BIN__ and __DOTFILES_DIR__ filled by install.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.james.keyboard.kanata</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KANATA_BIN__</string>
    <string>-n</string>
    <string>--cfg</string>
    <string>__DOTFILES_DIR__/configs/keyboard/kanata/main.resolved.kbd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Library/Logs/Kanata/kanata.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Kanata/kanata.stderr.log</string>
</dict>
</plist>
