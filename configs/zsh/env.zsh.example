# Example ~/.env.zsh - optional secrets and per-machine overrides, sourced by
# configs/zsh/core/03-env.zsh via `z4h source ~/.env.zsh`.
#
# Path overrides (optional). DOTFILES_DIR must be set before zshrc.
# export OBSIDIAN_PATH=$HOME/obsidian
# export FZF_TOOLS_DIR=$HOME/fzf-tools
# export DOTFILES_AI_DIR=$HOME/dotfiles-ai

# tssh default host (Mac). MagicDNS name from `tailscale status`, or a 100.x IP.
# export TSSH_HOST=my-pc
# export TSSH_USER=$USER

# export SERVICE_API_KEY=
# export GOOGLE_CLOUD_PROJECT=
